# Copia este archivo a .streamlit/secrets.toml (local) o pégalo en el panel de
# "Secrets" de Streamlit Community Cloud. NO subir el archivo real al repo.
#
# Autenticación por CUENTA DE SERVICIO (la llave NO caduca, a diferencia del
# refresh_token de OAuth que moría a los 7 días). Los valores salen del archivo
# JSON de la cuenta de servicio (service_account.json).

GOOGLE_SHEET_ID = "EL_ID_DE_TU_SPREADSHEET"

[gcp_service_account]
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"

# Importante: la cuenta de servicio (client_email) debe tener acceso de EDITOR
# al spreadsheet (no solo lector: el botón "Enviar a reingresos" escribe filas
# en la pestaña 'reingresos'). Compártelo desde Google Sheets con ese email.
